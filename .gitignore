**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Coverage output
coverage/

# Local tooling and agent state (never committed)
.omp/
.claude/
.superpowers/
/local/

# Superpowers and AI-assistant specs/plans (local working notes)
docs/superpowers/
**/superpowers/specs/
**/superpowers/plans/

# Local CI-mirror and smoke-test outputs
tool/ci/*.png
*-smoke.png

# Release artifacts produced by local builds
*.apk
*.aab
*.ipa
*.app/
*.dmg
simplex-blender-*.tar.gz
simplex-blender-*.zip

